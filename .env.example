# Copy to .env for local development. Never commit .env.
# All application settings use the APP_ prefix.

# local | dev | staging | prod
APP_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# true in any deployed environment
APP_LOG_JSON=false

# Required outside local. Without it, POST /v1/investigations returns 503.
APP_ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
APP_LLM_EFFORT=medium
# Per attempt. Hard deadline for a whole investigation is APP_INVESTIGATION_TIMEOUT_S.
APP_LLM_TIMEOUT_S=25
APP_LLM_MAX_RETRIES=0
APP_INVESTIGATION_TIMEOUT_S=50

APP_LOG_FIXTURE_PATH=fixtures/logs/checkout-deploy-regression.jsonl
